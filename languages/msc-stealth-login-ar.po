msgstr "محظور"

#: includes/class-msc-stealth-login-settings.php:1019
#: includes/class-msc-stealth-login-settings.php:1078
msgid "Whitelisted"
msgstr "في القائمة البيضاء"

#: includes/class-msc-stealth-login-settings.php:1023
msgid "Date From"
msgstr "التاريخ من"

#: includes/class-msc-stealth-login-settings.php:1029
msgid "Date To"
msgstr "التاريخ إلى"

#: includes/class-msc-stealth-login-settings.php:1038
msgid "Filter"
msgstr "تصفية"

#: includes/class-msc-stealth-login-settings.php:1039
msgid "Clear Filters"
msgstr "مسح المرشحات"

#: includes/class-msc-stealth-login-settings.php:1044
msgid "No login attempts recorded yet."
msgstr "لم يتم تسجيل محاولات تسجيل دخول بعد."

#. translators: %1$d: start number, %2$d: end number, %3$d: total count
#: includes/class-msc-stealth-login-settings.php:1048
#, php-format
msgid "Showing %1$d to %2$d of %3$d entries"
msgstr "عرض %1$d إلى %2$d من %3$d إدخالات"

