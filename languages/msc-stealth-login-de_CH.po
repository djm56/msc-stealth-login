#. Plugin Name of the plugin
#: msc-stealth-login.php
#: includes/class-msc-stealth-login-settings.php:295
msgid "MSC Stealth Login"
msgstr "MSC Stealth Login"

#. Plugin URI of the plugin
#. Author URI of the plugin
#: msc-stealth-login.php
msgid "https://anomalous.co.za"
msgstr ""

#. Description of the plugin
#: msc-stealth-login.php
msgid "Hide your login page, block brute force attacks, and protect your WordPress site from unauthorized access. Complete free plugin with all features included."
msgstr "Verstecken Sie Ihre Anmeldeseite, blockieren Sie Brute-Force-Angriffe und schützen Sie Ihre WordPress-Website vor unbefugtem Zugriff. Vollständiges kostenloses Plugin mit allen Funktionen."

#. Author of the plugin
#: msc-stealth-login.php
msgid "Anomalous Developers"
msgstr "Anomalous Developers"

#. translators: %s: list of detected plugins
#: includes/class-msc-stealth-login-module.php:89
#, php-format
msgid "The following plugins were detected: %s. You may need to configure cache or security exclusions for your custom login URL."
msgstr "Die folgenden Plugins wurden erkannt: %s. Möglicherweise müssen Sie Cache- oder Sicherheitsausnahmen für Ihre benutzerdefinierte Anmelde-URL konfigurieren."

#: includes/class-msc-stealth-login-module.php:205
#: includes/class-msc-stealth-login-module.php:1038
#: includes/class-msc-stealth-login-settings.php:114
#: includes/class-msc-stealth-login-settings.php:180
msgid "You do not have permission to access this page."
msgstr "Sie haben keine Berechtigung, auf diese Seite zuzugreifen."

#: includes/class-msc-stealth-login-module.php:459
msgid "Pingback functionality is disabled."
msgstr "Die Pingback-Funktionalität ist deaktiviert."

#. translators: %d is the number of minutes
#: includes/class-msc-stealth-login-module.php:693
#: includes/class-msc-stealth-login-module.php:817
#, php-format
msgid "Too many failed login attempts. Please try again in %d minutes."
msgstr "Zu viele fehlgeschlagene Anmeldeversuche. Bitte versuchen Sie es in %d Minuten erneut."

#. translators: %1$d days and %2$d hours
#: includes/class-msc-stealth-login-module.php:801
#, php-format
msgid "Too many failed login attempts. You are temporarily blocked for %1$d days and %2$d hours."
msgstr "Zu viele fehlgeschlagene Anmeldeversuche. Sie sind vorübergehend für %1$d Tage und %2$d Stunden gesperrt."

#. translators: %1$d hours and %2$d minutes
#: includes/class-msc-stealth-login-module.php:809
#, php-format
msgid "Too many failed login attempts. You are temporarily blocked for %1$d hours and %2$d minutes."
msgstr "Zu viele fehlgeschlagene Anmeldeversuche. Sie sind vorübergehend für %1$d Stunden und %2$d Minuten gesperrt."

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:847
#, php-format
msgid "[%s] Brute Force Lockout Alert"
msgstr "[%s] Brute-Force-Sperrungswarnung"

#. translators: 1 is the site name, 2 is the IP address, 3 is the number of attempts
#: includes/class-msc-stealth-login-module.php:865
#, php-format
msgid "A brute force lockout has occurred on %1$s.\n\nIP Address: %2$s\nFailed Attempts: %3$d\nTime: %4$s\n\nThis IP has been temporarily blocked from making login attempts.\n\nIf this is not expected behavior, you may want to investigate this IP address."
msgstr "Eine Brute-Force-Sperrung ist auf %1$s aufgetreten.\n\nIP-Adresse: %2$s\nFehlgeschlagene Versuche: %3$d\nZeit: %4$s\n\nDiese IP wurde vorübergehend für Anmeldeversuche gesperrt.\n\nWenn dies kein erwartetes Verhalten ist, sollten Sie diese IP-Adresse untersuchen."

#: includes/class-msc-stealth-login-module.php:901
#: includes/class-msc-stealth-login-module.php:933
#: includes/class-msc-stealth-login-settings.php:894
#: includes/class-msc-stealth-login-settings.php:951
msgid "Locked Out"
msgstr "Gesperrt"

#: includes/class-msc-stealth-login-module.php:954
#: includes/class-msc-stealth-login-module.php:986
msgid "Access Denied"
msgstr "Zugriff verweigert"

#: includes/class-msc-stealth-login-module.php:987
msgid "The login page you are trying to access has been hidden for security reasons. Please use the correct login URL to access this site."
msgstr "Die Anmeldeseite, auf die Sie zugreifen möchten, wurde aus Sicherheitsgründen versteckt. Bitte verwenden Sie die korrekte Anmelde-URL."

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:1065
#, php-format
msgid "[%s] Your Login URL Recovery"
msgstr "[%s] Wiederherstellung Ihrer Anmelde-URL"

#. translators: 1 is the site name, 2 is the login URL
#: includes/class-msc-stealth-login-module.php:1071
#, php-format
msgid "You requested a login URL recovery for %1$s. Your stealth login URL is: %2$s"
msgstr "Sie haben eine Wiederherstellung der Anmelde-URL für %1$s angefordert. Ihre Stealth-Anmelde-URL lautet: %2$s"

#: includes/class-msc-stealth-login-module.php:1107
msgid "Recovery email sent successfully."
msgstr "Wiederherstellungs-E-Mail erfolgreich gesendet."

#: includes/class-msc-stealth-login-module.php:1109
msgid "Failed to send recovery email. Please check the email address."
msgstr "Wiederherstellungs-E-Mail konnte nicht gesendet werden. Bitte überprüfen Sie die E-Mail-Adresse."

#: includes/class-msc-stealth-login-module.php:1111
msgid "Failed to send recovery email."
msgstr "Wiederherstellungs-E-Mail konnte nicht gesendet werden."

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:1176
#, php-format
msgid "[%s] User Login Alert"
msgstr "[%s] Benutzer-Anmeldewarnung"

#. translators: 1 is the username, 2 is the IP address, 3 is the time
#: includes/class-msc-stealth-login-module.php:1182
#, php-format
msgid "User: %1$s\nIP Address: %2$s\nTime: %3$s\n\nThis is an automated alert from your WordPress security plugin."
msgstr "Benutzer: %1$s\nIP-Adresse: %2$s\nZeit: %3$s\n\nDies ist eine automatische Warnung von Ihrem WordPress-Sicherheits-Plugin."

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:1229
#, php-format
msgid "[%s] New Login Location Detected"
msgstr "[%s] Neuer Anmeldestandort erkannt"

#. translators: 1 is the display name, 2 is the IP address, 3 is the time
#: includes/class-msc-stealth-login-module.php:1235
#, php-format
msgid "Hello %1$s,\n\nWe detected a login to your account from a new IP address:\n\nIP Address: %2$s\nTime: %3$s\n\nIf this was not you, please contact your site administrator immediately."
msgstr "Hallo %1$s,\n\nWir haben eine Anmeldung bei Ihrem Konto von einer neuen IP-Adresse erkannt:\n\nIP-Adresse: %2$s\nZeit: %3$s\n\nWenn Sie das nicht waren, kontaktieren Sie bitte sofort Ihren Website-Administrator."

#: includes/class-msc-stealth-login-settings.php:151
#: includes/class-msc-stealth-login-settings.php:679
#: includes/class-msc-stealth-login-settings.php:876
#: includes/class-msc-stealth-login-settings.php:930
msgid "IP Address"
msgstr "IP-Adresse"

#: includes/class-msc-stealth-login-settings.php:152
#: includes/class-msc-stealth-login-settings.php:882
#: includes/class-msc-stealth-login-settings.php:931
msgid "Username"
msgstr "Benutzername"

#: includes/class-msc-stealth-login-settings.php:153
#: includes/class-msc-stealth-login-settings.php:932
msgid "Result"
msgstr "Ergebnis"

#: includes/class-msc-stealth-login-settings.php:154
msgid "User Agent"
msgstr "User-Agent"

#: includes/class-msc-stealth-login-settings.php:155
#: includes/class-msc-stealth-login-settings.php:933
msgid "Date/Time"
msgstr "Datum/Uhrzeit"

#: includes/class-msc-stealth-login-settings.php:300
msgid "Settings updated successfully."
msgstr "Einstellungen erfolgreich aktualisiert."

#: includes/class-msc-stealth-login-settings.php:306
msgid "Settings"
msgstr "Einstellungen"

#: includes/class-msc-stealth-login-settings.php:309
msgid "Advanced"
msgstr "Erweitert"

#: includes/class-msc-stealth-login-settings.php:312
msgid "Email"
msgstr "E-Mail"

#: includes/class-msc-stealth-login-settings.php:315
msgid "History"
msgstr "Verlauf"

#: includes/class-msc-stealth-login-settings.php:318
msgid "Support"
msgstr "Unterstützung"

#: includes/class-msc-stealth-login-settings.php:332
msgid "Enable Stealth Login"
msgstr "Stealth-Anmeldung aktivieren"

#: includes/class-msc-stealth-login-settings.php:336
msgid "Enable stealth login protection"
msgstr "Stealth-Anmeldeschutz aktivieren"

#: includes/class-msc-stealth-login-settings.php:343
#: includes/class-msc-stealth-login-settings.php:744
msgid "Custom Login URL"
msgstr "Benutzerdefinierte Anmelde-URL"

#. translators: %s is the home URL
#: includes/class-msc-stealth-login-settings.php:351
#, php-format
msgid "Your login page will be at: %s"
msgstr "Ihre Anmeldeseite wird unter: %s erreichbar sein"

#: includes/class-msc-stealth-login-settings.php:360
#: includes/class-msc-stealth-login-settings.php:747
msgid "Hide wp-admin"
msgstr "wp-admin verstecken"

#: includes/class-msc-stealth-login-settings.php:364
msgid "Block direct access to wp-admin directory"
msgstr "Direkten Zugriff auf das wp-admin-Verzeichnis blockieren"

#: includes/class-msc-stealth-login-settings.php:367
msgid "Users will be redirected to your custom login URL or the specified URL when trying to access wp-admin directly."
msgstr "Benutzer werden auf Ihre benutzerdefinierte Anmelde-URL oder die angegebene URL umgeleitet, wenn sie versuchen, direkt auf wp-admin zuzugreifen."

#: includes/class-msc-stealth-login-settings.php:374
msgid "wp-admin Redirect URL"
msgstr "wp-admin Weiterleitungs-URL"

#: includes/class-msc-stealth-login-settings.php:379
msgid "Where to redirect users when they try to access wp-admin directly. Defaults to homepage."
msgstr "Wohin Benutzer umgeleitet werden, wenn sie versuchen, direkt auf wp-admin zuzugreifen. Standard ist die Startseite."

#: includes/class-msc-stealth-login-settings.php:386
msgid "Logout Redirect URL"
msgstr "Abmelde-Weiterleitungs-URL"

#: includes/class-msc-stealth-login-settings.php:391
msgid "Where to redirect users after logging out. Defaults to homepage."
msgstr "Wohin Benutzer nach dem Abmelden umgeleitet werden. Standard ist die Startseite."

#: includes/class-msc-stealth-login-settings.php:398
msgid "Login URL Preview"
msgstr "Anmelde-URL Vorschau"

#: includes/class-msc-stealth-login-settings.php:401
msgid "This is what your custom login URL will look like."
msgstr "So wird Ihre benutzerdefinierte Anmelde-URL aussehen."

#: includes/class-msc-stealth-login-settings.php:407
#: includes/class-msc-stealth-login-settings.php:759
msgid "Emergency Recovery URL"
msgstr "Notfall-Wiederherstellungs-URL"

#: includes/class-msc-stealth-login-settings.php:413
msgid "Current Recovery URL:"
msgstr "Aktuelle Wiederherstellungs-URL:"

#: includes/class-msc-stealth-login-settings.php:417
msgid "Copy URL"
msgstr "URL kopieren"

#: includes/class-msc-stealth-login-settings.php:419
msgid "Copied!"
msgstr "Kopiert!"

#: includes/class-msc-stealth-login-settings.php:422
msgid "Bookmark this URL! If you lose access to your custom login URL, use this recovery URL to access wp-login.php and then navigate to settings to find your custom URL."
msgstr "Setzen Sie ein Lesezeichen für diese URL! Wenn Sie den Zugriff auf Ihre benutzerdefinierte Anmelde-URL verlieren, verwenden Sie diese Wiederherstellungs-URL, um auf wp-login.php zuzugreifen."

#: includes/class-msc-stealth-login-settings.php:425
msgid "Are you sure? This will invalidate the current recovery URL."
msgstr "Sind Sie sicher? Dadurch wird die aktuelle Wiederherstellungs-URL ungültig."

#: includes/class-msc-stealth-login-settings.php:426
msgid "Regenerate Recovery URL"
msgstr "Wiederherstellungs-URL neu generieren"

#: includes/class-msc-stealth-login-settings.php:431
msgid "Recovery URL regenerated successfully!"
msgstr "Wiederherstellungs-URL erfolgreich neu generiert!"

#: includes/class-msc-stealth-login-settings.php:440
#: includes/class-msc-stealth-login-settings.php:606
#: includes/class-msc-stealth-login-settings.php:718
msgid "Save Settings"
msgstr "Einstellungen speichern"

#: includes/class-msc-stealth-login-settings.php:451
msgid "Advanced security features provide additional protection against brute force attacks, XML-RPC exploitation, and user enumeration via the REST API. These features are optional and may affect compatibility with some plugins or services that require XML-RPC or REST API access."
msgstr "Erweiterte Sicherheitsfunktionen bieten zusätzlichen Schutz gegen Brute-Force-Angriffe, XML-RPC-Ausnutzung und Benutzeraufzählung über die REST-API. Diese Funktionen sind optional und können die Kompatibilität mit einigen Plugins oder Diensten beeinträchtigen."

#: includes/class-msc-stealth-login-settings.php:455
msgid "Enable Advanced Security Features"
msgstr "Erweiterte Sicherheitsfunktionen aktivieren"

#: includes/class-msc-stealth-login-settings.php:459
msgid "Enable additional security features including brute force protection, XML-RPC blocking, and REST API protection."
msgstr "Aktivieren Sie zusätzliche Sicherheitsfunktionen einschließlich Brute-Force-Schutz, XML-RPC-Blockierung und REST-API-Schutz."

#: includes/class-msc-stealth-login-settings.php:462
msgid "When disabled, only the basic stealth login features will be active. Enable this to protect against automated attacks."
msgstr "Wenn deaktiviert, sind nur die grundlegenden Stealth-Anmeldefunktionen aktiv. Aktivieren Sie dies zum Schutz vor automatisierten Angriffen."

#: includes/class-msc-stealth-login-settings.php:468
msgid "XML-RPC & REST API Protection"
msgstr "XML-RPC & REST-API-Schutz"

#: includes/class-msc-stealth-login-settings.php:472
#: includes/class-msc-stealth-login-settings.php:750
msgid "Disable XML-RPC"
msgstr "XML-RPC deaktivieren"

#: includes/class-msc-stealth-login-settings.php:476
msgid "Block XML-RPC requests"
msgstr "XML-RPC-Anfragen blockieren"

#: includes/class-msc-stealth-login-settings.php:479
msgid "Prevents XML-RPC attacks and pingbacks. This also blocks the XML-RPC authentication method. Only available when Advanced Security is enabled."
msgstr "Verhindert XML-RPC-Angriffe und Pingbacks. Dies blockiert auch die XML-RPC-Authentifizierungsmethode. Nur verfügbar, wenn Erweiterte Sicherheit aktiviert ist."

#: includes/class-msc-stealth-login-settings.php:485
#: includes/class-msc-stealth-login-settings.php:753
msgid "Disable REST API User Enumeration"
msgstr "REST-API-Benutzeraufzählung deaktivieren"

#: includes/class-msc-stealth-login-settings.php:489
msgid "Block REST API user enumeration"
msgstr "REST-API-Benutzeraufzählung blockieren"

#: includes/class-msc-stealth-login-settings.php:492
msgid "Prevents attackers from discovering usernames via the REST API by querying ?author=1. Only available when Advanced Security is enabled."
msgstr "Verhindert, dass Angreifer Benutzernamen über die REST-API durch Abfrage von ?author=1 entdecken. Nur verfügbar, wenn Erweiterte Sicherheit aktiviert ist."

#: includes/class-msc-stealth-login-settings.php:498
#: includes/class-msc-stealth-login-settings.php:756
msgid "Brute Force Protection"
msgstr "Brute-Force-Schutz"

#: includes/class-msc-stealth-login-settings.php:502
msgid "Enable Brute Force Protection"
msgstr "Brute-Force-Schutz aktivieren"

#: includes/class-msc-stealth-login-settings.php:506
msgid "Enable login attempt limiting"
msgstr "Anmeldeversuch-Begrenzung aktivieren"

#: includes/class-msc-stealth-login-settings.php:509
msgid "Limits login attempts to prevent brute force attacks. Only available when Advanced Security is enabled."
msgstr "Begrenzt Anmeldeversuche, um Brute-Force-Angriffe zu verhindern. Nur verfügbar, wenn Erweiterte Sicherheit aktiviert ist."

#: includes/class-msc-stealth-login-settings.php:516
msgid "Max Login Attempts"
msgstr "Maximale Anmeldeversuche"

#: includes/class-msc-stealth-login-settings.php:521
msgid "Number of failed attempts before a temporary lockout (1-10)."
msgstr "Anzahl fehlgeschlagener Versuche vor einer vorübergehenden Sperrung (1-10)."

#: includes/class-msc-stealth-login-settings.php:528
msgid "Lockout Duration"
msgstr "Sperrdauer"

#: includes/class-msc-stealth-login-settings.php:532
#: includes/class-msc-stealth-login-settings.php:596
msgid "minutes"
msgstr "Minuten"

#: includes/class-msc-stealth-login-settings.php:534
msgid "How long the lockout lasts in minutes (5-60)."
msgstr "Wie lange die Sperrung in Minuten dauert (5-60)."

#: includes/class-msc-stealth-login-settings.php:540
msgid "Login Logging"
msgstr "Anmeldeprotokollierung"

#: includes/class-msc-stealth-login-settings.php:544
msgid "Enable Login Logging"
msgstr "Anmeldeprotokollierung aktivieren"

#: includes/class-msc-stealth-login-settings.php:548
msgid "Log all login attempts to database"
msgstr "Alle Anmeldeversuche in der Datenbank protokollieren"

#: includes/class-msc-stealth-login-settings.php:551
msgid "When enabled, all login attempts (success, failure, lockout) will be recorded in the database for review in the History tab."
msgstr "Wenn aktiviert, werden alle Anmeldeversuche (Erfolg, Fehlschlag, Sperrung) in der Datenbank für die Überprüfung im Verlaufs-Tab aufgezeichnet."

#: includes/class-msc-stealth-login-settings.php:557
msgid "IP Whitelist"
msgstr "IP-Whitelist"

#: includes/class-msc-stealth-login-settings.php:562
msgid "Whitelisted IP Addresses"
msgstr "Freigeschaltete IP-Adressen"

#: includes/class-msc-stealth-login-settings.php:567
msgid "Enter IP addresses that should bypass brute force protection. Enter one IP per line or separate with commas. Examples:"
msgstr "Geben Sie IP-Adressen ein, die den Brute-Force-Schutz umgehen sollen. Geben Sie eine IP pro Zeile ein oder trennen Sie sie mit Kommas. Beispiele:"

#: includes/class-msc-stealth-login-settings.php:574
msgid "Progressive Lockout"
msgstr "Progressive Sperrung"

#: includes/class-msc-stealth-login-settings.php:578
msgid "Progressive Lockout Delays"
msgstr "Progressive Sperrverzögerungen"

#: includes/class-msc-stealth-login-settings.php:582
msgid "Enable progressive lockout delays"
msgstr "Progressive Sperrverzögerungen aktivieren"

#: includes/class-msc-stealth-login-settings.php:585
msgid "Each subsequent lockout doubles the wait time. Helps stop persistent attackers. Resets after 24 hours of no attempts."
msgstr "Jede nachfolgende Sperrung verdoppelt die Wartezeit. Hilft, hartnäckige Angreifer zu stoppen. Wird nach 24 Stunden ohne Versuche zurückgesetzt."

#: includes/class-msc-stealth-login-settings.php:592
msgid "Maximum Lockout Duration"
msgstr "Maximale Sperrdauer"

#: includes/class-msc-stealth-login-settings.php:598
msgid "Maximum lockout duration even with progressive delays (60-1440 minutes)."
msgstr "Maximale Sperrdauer auch bei progressiven Verzögerungen (60-1440 Minuten)."

#: includes/class-msc-stealth-login-settings.php:617
msgid "Configure email notifications for login lockouts and alerts. These settings are independent of the Advanced Security features and can be enabled separately."
msgstr "Konfigurieren Sie E-Mail-Benachrichtigungen für Anmeldesperrungen und Warnungen. Diese Einstellungen sind unabhängig von den erweiterten Sicherheitsfunktionen."

#: includes/class-msc-stealth-login-settings.php:621
msgid "Enable Email Notifications"
msgstr "E-Mail-Benachrichtigungen aktivieren"

#: includes/class-msc-stealth-login-settings.php:625
msgid "Enable email notification features"
msgstr "E-Mail-Benachrichtigungsfunktionen aktivieren"

#: includes/class-msc-stealth-login-settings.php:628
msgid "Master toggle for all email notifications. When enabled, you can configure individual notification types below."
msgstr "Hauptschalter für alle E-Mail-Benachrichtigungen. Wenn aktiviert, können Sie einzelne Benachrichtigungstypen unten konfigurieren."

#: includes/class-msc-stealth-login-settings.php:634
msgid "Lockout Notifications"
msgstr "Sperrungsbenachrichtigungen"

#: includes/class-msc-stealth-login-settings.php:638
msgid "Lockout Email Notification"
msgstr "Sperrungs-E-Mail-Benachrichtigung"

#: includes/class-msc-stealth-login-settings.php:642
msgid "Send email when a lockout occurs"
msgstr "E-Mail senden, wenn eine Sperrung auftritt"

#: includes/class-msc-stealth-login-settings.php:649
msgid "Notification Email"
msgstr "Benachrichtigungs-E-Mail"

#: includes/class-msc-stealth-login-settings.php:654
msgid "Email address to receive lockout notifications. Defaults to site admin email."
msgstr "E-Mail-Adresse für Sperrungsbenachrichtigungen. Standard ist die Admin-E-Mail."

#: includes/class-msc-stealth-login-settings.php:661
msgid "Email Subject"
msgstr "E-Mail-Betreff"

#: includes/class-msc-stealth-login-settings.php:666
msgid "Custom email subject. Leave blank for default."
msgstr "Benutzerdefinierter E-Mail-Betreff. Leer lassen für Standard."

#: includes/class-msc-stealth-login-settings.php:673
msgid "Email Body"
msgstr "E-Mail-Text"

#: includes/class-msc-stealth-login-settings.php:678
msgid "Custom email body. Leave blank for default. Available placeholders:"
msgstr "Benutzerdefinierter E-Mail-Text. Leer lassen für Standard. Verfügbare Platzhalter:"

#: includes/class-msc-stealth-login-settings.php:680
msgid "Number of failed attempts"
msgstr "Anzahl fehlgeschlagener Versuche"

#: includes/class-msc-stealth-login-settings.php:681
msgid "Current time"
msgstr "Aktuelle Uhrzeit"

#: includes/class-msc-stealth-login-settings.php:682
msgid "Site name"
msgstr "Website-Name"

#: includes/class-msc-stealth-login-settings.php:683
msgid "Site URL"
msgstr "Website-URL"

#: includes/class-msc-stealth-login-settings.php:689
msgid "Login Alerts"
msgstr "Anmeldewarnungen"

#: includes/class-msc-stealth-login-settings.php:693
msgid "Admin Login Alert"
msgstr "Admin-Anmeldewarnung"

#: includes/class-msc-stealth-login-settings.php:697
msgid "Send email to admin when any user logs in"
msgstr "E-Mail an Admin senden, wenn sich ein Benutzer anmeldet"

#: includes/class-msc-stealth-login-settings.php:703
msgid "New IP Login Alert"
msgstr "Neue IP-Anmeldewarnung"

#: includes/class-msc-stealth-login-settings.php:707
msgid "Email user when they login from a new IP address"
msgstr "Benutzer per E-Mail benachrichtigen, wenn sie sich von einer neuen IP-Adresse anmelden"

#: includes/class-msc-stealth-login-settings.php:710
msgid "Users will be notified when their account is accessed from an IP address they have not used before."
msgstr "Benutzer werden benachrichtigt, wenn auf ihr Konto von einer IP-Adresse zugegriffen wird, die sie noch nicht verwendet haben."

#: includes/class-msc-stealth-login-settings.php:730
msgid "How to Use MSC Stealth Login"
msgstr "So verwenden Sie MSC Stealth Login"

#: includes/class-msc-stealth-login-settings.php:731
msgid "MSC Stealth Login helps secure your WordPress site by hiding the default login page and adding brute force protection."
msgstr "MSC Stealth Login sichert Ihre WordPress-Website, indem es die Standard-Anmeldeseite versteckt und Brute-Force-Schutz hinzufügt."

#: includes/class-msc-stealth-login-settings.php:733
msgid "Setting Up Your Custom Login URL"
msgstr "Einrichten Ihrer benutzerdefinierten Anmelde-URL"

#: includes/class-msc-stealth-login-settings.php:735
msgid "Go to the Settings tab above."
msgstr "Gehen Sie zum Einstellungen-Tab oben."

#: includes/class-msc-stealth-login-settings.php:736
msgid "Enter a custom login slug (e.g., \"my-secret-login\" or \"admin-access\")."
msgstr "Geben Sie einen benutzerdefinierten Anmelde-Slug ein (z.B. \"my-secret-login\" oder \"admin-access\")."

#: includes/class-msc-stealth-login-settings.php:737
msgid "Click Save Settings."
msgstr "Klicken Sie auf Einstellungen speichern."

#: includes/class-msc-stealth-login-settings.php:738
msgid "Your new login URL will be:"
msgstr "Ihre neue Anmelde-URL wird sein:"

#: includes/class-msc-stealth-login-settings.php:739
msgid "Bookmark this URL immediately!"
msgstr "Setzen Sie sofort ein Lesezeichen für diese URL!"

#: includes/class-msc-stealth-login-settings.php:739
msgid "Important:"
msgstr "Wichtig:"

#: includes/class-msc-stealth-login-settings.php:739
msgid "You will no longer be able to access wp-login.php directly."
msgstr "Sie können nicht mehr direkt auf wp-login.php zugreifen."

#: includes/class-msc-stealth-login-settings.php:742
msgid "Security Features Explained"
msgstr "Sicherheitsfunktionen erklärt"

#: includes/class-msc-stealth-login-settings.php:745
msgid "Changes your login page from /wp-login.php to a custom URL of your choice. This prevents automated bots from finding your login page."
msgstr "Ändert Ihre Anmeldeseite von /wp-login.php in eine benutzerdefinierte URL Ihrer Wahl. Dies verhindert, dass automatisierte Bots Ihre Anmeldeseite finden."

#: includes/class-msc-stealth-login-settings.php:748
msgid "Blocks direct access to the /wp-admin/ directory and redirects users to your custom login URL. Prevents unauthorized access attempts."
msgstr "Blockiert den direkten Zugriff auf das /wp-admin/-Verzeichnis und leitet Benutzer auf Ihre benutzerdefinierte Anmelde-URL um."

#: includes/class-msc-stealth-login-settings.php:751
msgid "Blocks XML-RPC requests which are commonly used for brute force attacks and pingback spam. If you use mobile apps or external services that require XML-RPC, leave this disabled."
msgstr "Blockiert XML-RPC-Anfragen, die häufig für Brute-Force-Angriffe und Pingback-Spam verwendet werden. Wenn Sie mobile Apps oder externe Dienste verwenden, die XML-RPC erfordern, lassen Sie dies deaktiviert."

#: includes/class-msc-stealth-login-settings.php:754
msgid "Prevents attackers from discovering usernames by querying the REST API with ?author=1, ?author=2, etc."
msgstr "Verhindert, dass Angreifer Benutzernamen durch Abfrage der REST-API mit ?author=1, ?author=2 usw. entdecken."

#: includes/class-msc-stealth-login-settings.php:757
msgid "Limits login attempts to prevent brute force attacks. After the configured number of failed attempts, the IP address is temporarily blocked."
msgstr "Begrenzt Anmeldeversuche, um Brute-Force-Angriffe zu verhindern. Nach der konfigurierten Anzahl fehlgeschlagener Versuche wird die IP-Adresse vorübergehend gesperrt."

#: includes/class-msc-stealth-login-settings.php:760
msgid "A special URL that allows you to access wp-login.php even when the plugin is active. This is your safety net if you forget your custom login URL. Bookmark this URL and keep it safe!"
msgstr "Eine spezielle URL, mit der Sie auf wp-login.php zugreifen können, auch wenn das Plugin aktiv ist. Dies ist Ihr Sicherheitsnetz. Setzen Sie ein Lesezeichen und bewahren Sie es sicher auf!"

#: includes/class-msc-stealth-login-settings.php:762
msgid "Frequently Asked Questions"
msgstr "Häufig gestellte Fragen"

#: includes/class-msc-stealth-login-settings.php:764
msgid "What happens if I forget my custom login URL?"
msgstr "Was passiert, wenn ich meine benutzerdefinierte Anmelde-URL vergesse?"

#: includes/class-msc-stealth-login-settings.php:765
msgid "Use the Emergency Recovery URL shown on the Settings tab. Bookmark this URL when you first set up the plugin. If you lose both URLs, you will need to disable the plugin via FTP or WP-CLI to regain access."
msgstr "Verwenden Sie die Notfall-Wiederherstellungs-URL auf dem Einstellungen-Tab. Setzen Sie ein Lesezeichen bei der Ersteinrichtung. Wenn Sie beide URLs verlieren, müssen Sie das Plugin per FTP oder WP-CLI deaktivieren."

#: includes/class-msc-stealth-login-settings.php:767
msgid "Will this break my site?"
msgstr "Wird dies meine Website beschädigen?"

#: includes/class-msc-stealth-login-settings.php:768
msgid "If configured correctly, no. However, we strongly recommend testing on a staging site first. Always bookmark your custom login URL and the recovery URL before logging out."
msgstr "Wenn richtig konfiguriert, nein. Wir empfehlen jedoch dringend, zunächst auf einer Staging-Website zu testen. Setzen Sie immer Lesezeichen für Ihre Anmelde-URL und die Wiederherstellungs-URL."

#: includes/class-msc-stealth-login-settings.php:770
msgid "Can I still use wp-admin after logging in?"
msgstr "Kann ich nach der Anmeldung weiterhin wp-admin verwenden?"

#: includes/class-msc-stealth-login-settings.php:771
msgid "Yes! Once you are logged in, wp-admin works normally. The \"Hide wp-admin\" feature only blocks direct access for non-logged-in users."
msgstr "Ja! Sobald Sie angemeldet sind, funktioniert wp-admin normal. Die Funktion \"wp-admin verstecken\" blockiert nur den direkten Zugriff für nicht angemeldete Benutzer."

#: includes/class-msc-stealth-login-settings.php:773
msgid "Will this work with my security plugin?"
msgstr "Funktioniert dies mit meinem Sicherheits-Plugin?"

#: includes/class-msc-stealth-login-settings.php:774
msgid "Generally yes, but avoid using multiple plugins that modify login URLs or block wp-admin simultaneously as they may conflict."
msgstr "Im Allgemeinen ja, aber vermeiden Sie die gleichzeitige Verwendung mehrerer Plugins, die Anmelde-URLs ändern oder wp-admin blockieren."

#: includes/class-msc-stealth-login-settings.php:776
msgid "Does this work with WooCommerce?"
msgstr "Funktioniert dies mit WooCommerce?"

#: includes/class-msc-stealth-login-settings.php:777
msgid "Yes, but note that WooCommerce has its own login/my-account pages. You may need to test compatibility with your specific setup."
msgstr "Ja, aber beachten Sie, dass WooCommerce eigene Anmelde-/Kontoseiten hat. Möglicherweise müssen Sie die Kompatibilität mit Ihrem Setup testen."

#: includes/class-msc-stealth-login-settings.php:779
msgid "How do I disable the plugin if I get locked out?"
msgstr "Wie deaktiviere ich das Plugin, wenn ich ausgesperrt werde?"

#: includes/class-msc-stealth-login-settings.php:781
msgid "Use the Emergency Recovery URL (if you have it bookmarked)"
msgstr "Verwenden Sie die Notfall-Wiederherstellungs-URL (falls Sie ein Lesezeichen gesetzt haben)"

#: includes/class-msc-stealth-login-settings.php:782
msgid "Via FTP/SFTP: Rename the plugin folder from /wp-content/plugins/msc-stealth-login/ to /wp-content/plugins/msc-stealth-login-disabled/"
msgstr "Per FTP/SFTP: Benennen Sie den Plugin-Ordner von /wp-content/plugins/msc-stealth-login/ in /wp-content/plugins/msc-stealth-login-disabled/ um"

#: includes/class-msc-stealth-login-settings.php:783
msgid "Via WP-CLI: Run: wp plugin deactivate msc-stealth-login"
msgstr "Per WP-CLI: Ausführen: wp plugin deactivate msc-stealth-login"

#: includes/class-msc-stealth-login-settings.php:784
msgid "Via Database: Set the mscsl_options option value to have module_enabled = 0"
msgstr "Per Datenbank: Setzen Sie den mscsl_options-Optionswert auf module_enabled = 0"

