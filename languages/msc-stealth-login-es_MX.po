#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:872
#, php-format
msgid "[%s] Brute Force Lockout Alert"
msgstr "[%s] Alerta de bloqueo por fuerza bruta"

#. translators: %d: number of failed login attempts
#: includes/class-msc-stealth-login-module.php:895
#, php-format
msgid "Failed Attempt: %d"
msgid_plural "Failed Attempts: %d"
msgstr[0] "Intento fallido: %d"
msgstr[1] "Intentos fallidos: %d"
#. translators: 1: site name, 2: IP address, 3: failed attempts line, 4: time
#: includes/class-msc-stealth-login-module.php:901
#, php-format
msgid ""
"A brute force lockout has occurred on %1$s.\n"
"\n"
"IP Address: %2$s\n"
"%3$s\n"
"Time: %4$s\n"
"\n"
"This IP has been temporarily blocked from making login attempts.\n"
"\n"
"If this is not expected behavior, you may want to investigate this IP "
"address."
msgstr ""
"Ha ocurrido un bloqueo por fuerza bruta en %1$s.\n"
"\n"
"Dirección IP: %2$s\n"
"%3$s\n"
"Hora: %4$s\n"
"\n"
"Esta IP ha sido bloqueada temporalmente para realizar intentos de inicio de "
"sesión.\n"
"\n"
"Si este no es el comportamiento esperado, puede investigar esta dirección IP."

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:1046
#, php-format
msgid "[%s] Your Login URL Recovery"
msgstr "[%s] Recuperación de tu URL de inicio de sesión"

#. translators: 1: site name, 2: login URL
#: includes/class-msc-stealth-login-module.php:1052
#, php-format
msgid ""
"You requested a login URL recovery for %1$s. Your stealth login URL is: %2$s"
msgstr ""
"Has solicitado una recuperación de URL de inicio de sesión para %1$s. Tu URL "
"de inicio de sesión sigilosa es: %2$s"

#: includes/class-msc-stealth-login-module.php:1092
msgid "Recovery email sent successfully."
msgstr "Correo de recuperación enviado correctamente."

#: includes/class-msc-stealth-login-module.php:1094
msgid "Failed to send recovery email. Please check the email address."
msgstr ""
"No se pudo enviar el correo de recuperación. Por favor, verifica la "
"dirección de correo."

#: includes/class-msc-stealth-login-module.php:1096
msgid "Failed to send recovery email."
msgstr "No se pudo enviar el correo de recuperación."

#: includes/class-msc-stealth-login-module.php:1126
msgid "MSC Stealth Login:"
msgstr "MSC Stealth Login:"

#. translators: %s: Link to plugin settings page
#: includes/class-msc-stealth-login-module.php:1130
#, php-format
msgid ""
"This plugin collects IP addresses, usernames, user agents, and login attempt "
"history for security features (brute force protection, login alerts). This "
"data is stored in your WordPress database and is not sent externally. You "
"can manage settings on the %s page."
msgstr ""
"Este plugin recopila direcciones IP, nombres de usuario, agentes de usuario "
"e historial de intentos de inicio de sesión para funciones de seguridad "
"(protección contra fuerza bruta, alertas de inicio de sesión). Estos datos "
"se almacenan en su base de datos WordPress y no se envían externamente. "
"Puede gestionar la configuración en la página de %s."

#: includes/class-msc-stealth-login-module.php:1131
msgid "plugin settings"
msgstr "ajustes del plugin"

#: includes/class-msc-stealth-login-module.php:1149
msgid "Unauthorized"
msgstr "No autorizado"

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:1215
#, php-format
msgid "[%s] User Login Alert"
msgstr "[%s] Alerta de inicio de sesión de usuario"

#. translators: 1: username, 2: IP address, 3: time
#: includes/class-msc-stealth-login-module.php:1221
#, php-format
msgid ""
"User: %1$s\n"
"IP Address: %2$s\n"
"Time: %3$s\n"
"\n"
"This is an automated alert from your WordPress security plugin."
msgstr ""
"Usuario: %1$s\n"
"Dirección IP: %2$s\n"
"Hora: %3$s\n"
"\n"
"Esta es una alerta automatizada de su plugin de seguridad de WordPress."

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:1268
#, php-format
msgid "[%s] New Login Location Detected"
msgstr "[%s] Nueva ubicación de inicio de sesión detectada"

#. translators: 1: display name, 2: IP address, 3: time
#: includes/class-msc-stealth-login-module.php:1274
#, php-format
msgid ""
"Hello %1$s,\n"
"\n"
"We detected a login to your account from a new IP address:\n"
"\n"
"IP Address: %2$s\n"
"Time: %3$s\n"
"\n"
"If this was not you, please contact your site administrator immediately."
msgstr ""
"Hola %1$s,\n"
"\n"
"Hemos detectado un inicio de sesión en su cuenta desde una nueva dirección "
"IP:\n"
"\n"
"Dirección IP: %2$s\n"
"Hora: %3$s\n"
"\n"
"Si no fue usted, contacte de inmediato al administrador del sitio."

