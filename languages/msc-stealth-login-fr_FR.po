msgstr "La fonctionnalité de rétrolien est désactivée."

#. translators: %d is the number of minutes
#: includes/class-msc-stealth-login-module.php:718
#: includes/class-msc-stealth-login-module.php:842
#, php-format
msgid "Too many failed login attempts. Please try again in %d minutes."
msgstr ""
"Trop de tentatives de connexion échouées. Veuillez réessayer dans %d "
"minutes."

#. translators: %1$d days and %2$d hours
#: includes/class-msc-stealth-login-module.php:826
#, php-format
msgid ""
"Too many failed login attempts. You are temporarily blocked for %1$d days "
"and %2$d hours."
msgstr ""
"Trop de tentatives de connexion échouées. Vous êtes temporairement bloqué "
"pour %1$d jours et %2$d heures."

#. translators: %1$d hours and %2$d minutes
#: includes/class-msc-stealth-login-module.php:834
#, php-format
msgid ""
"Too many failed login attempts. You are temporarily blocked for %1$d hours "
