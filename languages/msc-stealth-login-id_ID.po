#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:872
#, php-format
msgid "[%s] Brute Force Lockout Alert"
msgstr "[%s] Peringatan Pemblokiran Brute Force"

#. translators: 1: site name, 2: IP address, 3: number of failed attempts, 4:
#. time
#: includes/class-msc-stealth-login-module.php:890
#, php-format
msgid ""
"A brute force lockout has occurred on %1$s.\n"
"\n"
"IP Address: %2$s\n"
"Failed Attempts: %3$d\n"
"Time: %4$s\n"
"\n"
"This IP has been temporarily blocked from making login attempts.\n"
"\n"
"If this is not expected behavior, you may want to investigate this IP address."
msgstr ""
"Pemblokiran brute force telah terjadi pada %1$s.\n"
"\n"
"Alamat IP: %2$s\n"
"Percobaan Gagal: %3$d\n"
"Waktu: %4$s\n"
"\n"
"IP ini telah diblokir sementara dari melakukan percobaan login.\n"
"\n"
"Jika ini bukan perilaku yang diharapkan, Anda mungkin ingin menyelidiki alamat IP ini."

#. translators: %s is the site name
