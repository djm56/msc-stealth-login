"Too many failed login attempts. You are temporarily blocked for %1$d hours "
"and %2$d minutes."
msgstr ""
"Te veel mislukte inlogpogingen. Je bent tijdelijk geblokkeerd voor %1$d uur "
"en %2$d minuten."

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:872
#, php-format
msgid "[%s] Brute Force Lockout Alert"
msgstr "[%s] Brute force-blokkeringswaarschuwing"

#. translators: %d: number of failed login attempts
#: includes/class-msc-stealth-login-module.php:895
#, php-format
msgid "Failed Attempt: %d"
msgid_plural "Failed Attempts: %d"
msgstr[0] "Mislukte poging: %d"
msgstr[1] "Mislukte pogingen: %d"
#. translators: 1: site name, 2: IP address, 3: failed attempts line, 4: time
#: includes/class-msc-stealth-login-module.php:901
#, php-format
msgid ""
"A brute force lockout has occurred on %1$s.\n"
"\n"
"IP Address: %2$s\n"
"%3$s\n"
"Time: %4$s\n"
"\n"
"This IP has been temporarily blocked from making login attempts.\n"
"\n"
"If this is not expected behavior, you may want to investigate this IP "
"address."
msgstr ""
"Er heeft een brute force-blokkering plaatsgevonden op %1$s.\n"
"\n"
"IP-adres: %2$s\n"
"%3$s\n"
"Tijd: %4$s\n"
"\n"
"Dit IP is tijdelijk geblokkeerd voor het doen van inlogpogingen.\n"
"\n"
"Als dit niet het verwachte gedrag is, kun je dit IP-adres onderzoeken."

#. translators: %s is the site name
#: includes/class-msc-stealth-login-module.php:1046
#, php-format
