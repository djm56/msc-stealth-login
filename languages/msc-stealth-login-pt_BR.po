#: includes/class-msc-stealth-login-settings.php:393
#: includes/class-msc-stealth-login-settings.php:817
msgid "Hide wp-admin"
msgstr "Ocultar wp-admin"

#: includes/class-msc-stealth-login-settings.php:397
msgid "Block direct access to wp-admin directory"
msgstr "Bloquear acesso direto ao diretório wp-admin"

#: includes/class-msc-stealth-login-settings.php:400
msgid ""
"Users will be redirected to your custom login URL or the specified URL when "
