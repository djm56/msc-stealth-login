msgstr ""
"Нужна помощь? Посетите <a href=\"%s\" target=\"_blank\" rel=\"noopener "
"noreferrer\">форум поддержки плагина на WordPress.org</a> для помощи, "
"сообщений об ошибках и запросов функций."

#: includes/class-msc-stealth-login-settings.php:915
msgid "All login logs have been cleared."
msgstr "Все журналы входа были очищены."

