msgstr ""
"Куда перенаправлять пользователей при попытке прямого доступа к wp-admin. По"
" умолчанию — главная страница."

#: includes/class-msc-stealth-login-settings.php:419
msgid "Logout Redirect URL"
msgstr "URL перенаправления при выходе"

#: includes/class-msc-stealth-login-settings.php:424
