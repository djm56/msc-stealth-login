parameters:
	ignoreErrors:
		-
			message: '#^Found usage of constant DOING_AJAX\. Use wp_doing_ajax\(\) instead\.$#'
			identifier: phpstanWP.wpConstant.fetch
			count: 1
			path: includes/class-msc-stealth-login-module.php

		-
			message: '#^Constant MSCSL_PLUGIN_URL not found\.$#'
			identifier: constant.notFound
			count: 2
			path: includes/class-msc-stealth-login-settings.php

		-
			message: '#^Parameter \#1 \$args of function paginate_links expects array\{base\?\: string, format\?\: string, total\?\: int, current\?\: int, aria_current\?\: string, show_all\?\: bool, end_size\?\: int, mid_size\?\: int, \.\.\.\}, array\{base\: string, format\: '''', prev_text\: string, next_text\: string, total\: float, current\: int\<1, max\>, add_args\: array\{page\: ''msc\-stealth\-login'', tab\: ''history''\}\} given\.$#'
			identifier: argument.type
			count: 1
			path: includes/class-msc-stealth-login-settings.php

		-
			message: '#^Property MSCSL\\Plugin\:\:\$module is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: includes/class-msc-stealth-login.php

		-
			message: '#^Property MSCSL\\Plugin\:\:\$settings is never read, only written\.$#'
			identifier: property.onlyWritten
			count: 1
			path: includes/class-msc-stealth-login.php

		-
			message: '#^Variable \$entry in empty\(\) always exists and is not falsy\.$#'
			identifier: empty.variable
			count: 1
			path: includes/class-msc-stealth-login.php
